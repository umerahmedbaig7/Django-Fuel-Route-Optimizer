# Copy to .env and fill in. Never commit .env.

# Free key from https://account.heigit.org/ (required for the /api/route/ endpoint)
ORS_API_KEY=

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional overrides
# FUEL_CSV_PATH=data/fuel-prices-for-be-assessment.csv
# ORS_BASE_URL=https://account.heigit.org/
# API_THROTTLE_RATE=30/min
# LOG_LEVEL=INFO
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   (use another provider for heavy traffic)
